# Copy to .env.development.local (pnpm dev) and .env.production.local (pnpm build, and `pnpm -s envtob64` for the
# ENV_FILE_BASE64 secret).
# Don't add NODE_ENV, PORT or HOSTNAME: in production the systemd unit sets them, and the deploy strips them from here.

# Google Gemini API key (server-side only, never exposed to the browser)
GEMINI_KEY=

# --- Build time only. NEXT_PUBLIC_* values are inlined by `pnpm build`; in production the build job reads them from ENV_FILE_BASE64. ---

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Empty: analytics off. See docs/GOOGLE_ANALYTICS.md
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Sentry DSN (https://<key>@<org>.ingest.sentry.io/<project>). Empty: error tracking off. See docs/SENTRY.md
NEXT_PUBLIC_SENTRY_DSN=

# Sentry source map upload (CI only; leave empty locally)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
