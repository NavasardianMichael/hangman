# Copy to .env.development.local (pnpm dev) and .env.production.local (pnpm build, and `pnpm -s envtob64` for the
# ENV_FILE_BASE64 secret).
# Don't add NODE_ENV, PORT or HOSTNAME: in production the systemd unit sets them, and the deploy strips them from here.

# Google Gemini API key (server-side only, never exposed to the browser)
GEMINI_KEY=

# --- Payments (docs/PAYMENTS.md). Runtime, server only. ---

# `mock` (development default: a fake bank page served by this app) or `ameria`. `mock` is refused in production.
PAYMENT_GATEWAY=mock

# Ameriabank vPOS 3.1. Credentials come from the bank (vpos.support@ameriabank.am).
AMERIA_CLIENT_ID=
AMERIA_USERNAME=
AMERIA_PASSWORD=
# Only the exact value "false" uses the live terminal; anything else (unset too) uses servicestest.ameriabank.am.
AMERIA_TEST_MODE=true
# OrderID sent to the bank = this + the payment's order number. Test: the start of the range the bank assigned.
# Live: a value that never collides with the test OrderIDs (or with another site on the same terminal).
AMERIA_ORDER_ID_OFFSET=0
# Overrides the charged amount in whole drams. The test terminal accepts only 10; leave it unset live.
# AMERIA_AMOUNT_OVERRIDE=10

# Where the payments database (SQLite) lives. Development default: ./.data. Production: set by the deploy to
# APP_DIR/shared/data, so leave it out of .env.production.local.
# DATA_DIR=

# This site's public origin, for the bank's BackURL. Defaults: https://hangman.eapps.site in production,
# http://localhost:7005 in development.
# PUBLIC_URL=

# --- Mail engine (the same one cv-builder uses): the contact form and payment alerts to the admin inbox. ---
# Empty in development: messages print to the server console. Production without it: the contact form answers 503.
MAIL_API_URL=
MAIL_API_KEY=

# --- Build time only. NEXT_PUBLIC_* values are inlined by `pnpm build`; in production the build job reads them from ENV_FILE_BASE64. ---

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Empty: analytics off. See docs/GOOGLE_ANALYTICS.md
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Sentry DSN (https://<key>@<org>.ingest.sentry.io/<project>). Empty: error tracking off. See docs/SENTRY.md
NEXT_PUBLIC_SENTRY_DSN=

# Sentry source map upload (CI only; leave empty locally)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
